# Provider key used by the model selected below. Never commit real keys.
ANTHROPIC_API_KEY=

# Pi model selector used by this project.
PI_PROVIDER=anthropic
PI_MODEL=claude-sonnet-4-5

# Daily briefing workflow. Live collection requires a Tavily API key; replay mode does not.
APP_TIMEZONE=Asia/Shanghai
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5

# Optional StockScope-compatible delivery. Leave URL empty to keep reports local only.
BRIEFING_REPORT_API_URL=
BRIEFING_REPORT_API_KEY=
BRIEFING_PUBLISHER=玄弈
