# Provider key used by the model selected below. Never commit real keys.
DEEPSEEK_API_KEY=

# Pi's built-in DeepSeek provider uses https://api.deepseek.com.
PI_PROVIDER=deepseek
PI_MODEL=deepseek-v4-flash
# For OpenAI-compatible gateways (DeepSeek, Aliyun MaaS Qwen, Ollama, etc.), set PI_BASE_URL
# and either PI_API_KEY or <PROVIDER>_API_KEY. Example:
# PI_PROVIDER=qwen
# PI_MODEL=qwen3.7-flash
# PI_BASE_URL=https://example.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# PI_API_KEY=
PI_BASE_URL=
PI_API_KEY=
# Cursor subscription via the Pi native Provider and independent browser authorization:
# PI_PROVIDER=cursor
# PI_MODEL=auto
# Run: livermore cursor login (does not reuse IDE/CLI or global Pi credentials).
MODEL_COST_INPUT_PER_MILLION=0.025
MODEL_COST_OUTPUT_PER_MILLION=3
MODEL_COST_CURRENCY=CNY

# Daily briefing workflow. Tavily is optional; direct public sources are used as fallback.
APP_TIMEZONE=Asia/Shanghai
# Initial values for the Tavily entry created the first time the database starts.
# After that, switch, edit, add, and delete MCP servers in the capability ledger.
TAVILY_MCP_ENABLED=true
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5

# Futu OpenD read-only market data. FUTU_PYTHON must have futu-api >= 10.4.6408.
FUTU_PYTHON=/usr/bin/python3
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111

# Local trace collection. Install/start Phoenix with: npm run phoenix -- install/start
TRACING_ENABLED=true
TRACE_CONTENT_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_UI_URL=http://localhost:6006
LIVERMORE_WEB_PORT=4310
LIVERMORE_WEB_UI_URL=http://127.0.0.1:4310

# Local message center. Feishu and WeCom group robot webhooks are supported.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WEBHOOK_URL=
WECHAT_WEBHOOK_URL=
NOTIFY_ON_SUCCESS=true
# macOS 通知默认启用，需在系统提示中允许；失败不影响本地消息和飞书。
MACOS_NOTIFICATIONS_ENABLED=true
# 应用打开时自动调度；退出后继续运行需启用后台模式。
TASK_SCHEDULER_ENABLED=true
