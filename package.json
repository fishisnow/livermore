{
  "name": "livermore",
  "version": "0.1.0",
  "private": true,
  "description": "A research-only investment agent with resilient daily market and AI industry briefings.",
  "type": "module",
  "bin": {
    "livermore": "bin/livermore.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --import tsx src/cli.ts",
    "start": "node --import tsx src/cli.ts",
    "briefing": "node --import tsx src/briefing-cli.ts",
    "portfolio:risk": "node --import tsx src/portfolio-risk-cli.ts",
    "runs": "node --import tsx src/runs-cli.ts",
    "notify:test": "node --import tsx src/notification-cli.ts",
    "scheduler": "node --import tsx src/scheduler-cli.ts",
    "phoenix": "node --import tsx src/phoenix-cli.ts",
    "web": "node --import tsx src/web-server.ts",
    "feishu": "node --import tsx src/feishu-bot-cli.ts",
    "install:local": "node bin/install.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.80.8",
    "@earendil-works/pi-ai": "0.80.8",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sinclair/typebox": "0.34.52",
    "defuddle": "^0.19.1",
    "linkedom": "^0.18.13"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
